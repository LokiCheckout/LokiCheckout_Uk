<script>
    LokiComponentExtender.extend('LokiCheckoutComponent', 'UkPostcodeMaskMixin', () => {
        return {
            ukPostcodeMask(input) {
                return /^[A-Z]{2}/i.test(input)
                    ? 'aa** 9aa'
                    : 'a** 9aa';
            }
        }
    }, {when: component => component.fieldName === 'postcode'});
</script>
