<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="loki-checkout.shipping.address.street0">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Address line 1</argument>
                <argument name="md_col_span" xsi:type="number">12</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.street1">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Address line 2 (optional)</argument>
                <argument name="md_col_span" xsi:type="number">12</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.street2">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Address line 3 (optional)</argument>
                <argument name="md_col_span" xsi:type="number">12</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.postcode">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Postcode</argument>
                <argument name="placeholder" xsi:type="string">SW1A 1AA</argument>
                <argument name="field_attributes" xsi:type="array">
                    <item name="x-mask:dynamic" xsi:type="string">ukPostcodeMask</item>
                </argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.shipping.address.region">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">State</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.street0">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Address line 1</argument>
                <argument name="md_col_span" xsi:type="number">12</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.street1">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Address line 2</argument>
                <argument name="md_col_span" xsi:type="number">12</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.street2">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Address line 3</argument>
                <argument name="md_col_span" xsi:type="number">12</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.postcode">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">Postcode</argument>
                <argument name="placeholder" xsi:type="string">SW1A 1AA</argument>
                <argument name="field_attributes" xsi:type="array">
                    <item name="x-mask:dynamic" xsi:type="string">ukPostcodeMask</item>
                </argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.billing.address.region">
            <arguments>
                <argument name="field_label" xsi:type="string" translate="true">State</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
